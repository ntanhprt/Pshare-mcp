{
  "name": "pshare-share-mcp",
  "version": "1.0.0",
  "description": "MCP server that lets an AI upload files/folders to Pshare and get back a share link",
  "type": "module",
  "bin": {
    "pshare-share-mcp": "./dist/index.js"
  },
  "scripts": {
